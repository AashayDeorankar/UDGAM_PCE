# TechPrep Environment Configuration Template
# Copy this file to .env and provide your credentials as needed.

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# Firebase Authentication & Firestore (optional for local demo mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API Base URL (defaults to http://localhost:3001 in dev)
VITE_API_BASE_URL=http://localhost:3001

# Supabase (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin email list (comma-separated)
VITE_ADMIN_EMAILS=amanvverma109@gmail.com

# ==========================================
# Backend Configuration (Node.js API)
# ==========================================
PORT=3001

# AI Study Buddy & Mock Interview LLM (OpenRouter or OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# AWS S3 for Study Materials & Avatars
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=btech-verse

# Email Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TechPrep <onboarding@resend.dev>
BOOK_SESSION_ADMIN_EMAIL=

# WhatsApp Notifications (Twilio - optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
BOOK_SESSION_ADMIN_WHATSAPP=

# Firebase Admin Service Account (for server-side token validation)
# Provide either JSON string or path to JSON file
FIREBASE_SERVICE_ACCOUNT_JSON=
